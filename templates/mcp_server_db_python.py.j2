"""Auto-generated MCP server for {{ db_type }} database

Read-only database exploration tools.
Connection: {{ connection_string }}

Usage:
    pip install mcp
    python {{ server_name }}.py
"""

import os
import json
{% if db_type == "sqlite" %}
import sqlite3
{% elif db_type == "postgresql" %}
import psycopg2
{% elif db_type == "mysql" %}
import pymysql
from urllib.parse import urlparse, parse_qs
{% endif %}
from mcp.server import Server
from mcp.server.stdio import stdio_server
from mcp.types import Tool, TextContent


server = Server("{{ server_name }}")

DB_URL = os.environ.get("DATABASE_URL", """{{ connection_string }}""")


{% if db_type == "sqlite" %}
def _get_conn():
    db_path = DB_URL.replace("sqlite:///", "").replace("sqlite://", "")
    conn = sqlite3.connect(db_path)
    conn.row_factory = sqlite3.Row
    return conn
{% elif db_type == "postgresql" %}
def _get_conn():
    return psycopg2.connect(DB_URL)
{% elif db_type == "mysql" %}
def _get_conn():
    parsed = urlparse(DB_URL)
    return pymysql.connect(
        host=parsed.hostname or "localhost",
        port=parsed.port or 3306,
        user=parsed.username or "root",
        password=parsed.password or "",
        database=parsed.path.lstrip("/") if parsed.path else "",
    )
{% endif %}


@server.tool()
async def list_tables() -> list[TextContent]:
    """List all tables in the database with their row counts."""
    conn = _get_conn()
    cursor = conn.cursor()

{% if db_type == "sqlite" %}
    cursor.execute("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' AND name NOT LIKE '\\_%'")
    tables = [row[0] for row in cursor.fetchall()]
    result = []
    for t in tables:
        cursor.execute(f"SELECT COUNT(*) FROM '{t}'")
        result.append({"table": t, "row_count": cursor.fetchone()[0]})
{% elif db_type == "postgresql" %}
    cursor.execute("""
        SELECT table_name,
               (SELECT reltuples::bigint FROM pg_class WHERE relname = table_name)
        FROM information_schema.tables
        WHERE table_schema = 'public' AND table_type = 'BASE TABLE'
        ORDER BY table_name
    """)
    result = [{"table": row[0], "row_count": row[1]} for row in cursor.fetchall()]
{% elif db_type == "mysql" %}
    cursor.execute("SHOW TABLE STATUS")
    result = [{"table": row[0], "row_count": row[4]} for row in cursor.fetchall()]
{% endif %}

    conn.close()
    return [TextContent(type="text", text=json.dumps(result, indent=2, ensure_ascii=False, default=str))]

{% for table in tables %}
@server.tool()
async def describe_{{ table.name }}() -> list[TextContent]:
    """Get the schema of the '{{ table.name }}' table."""
    conn = _get_conn()
    cursor = conn.cursor()

{% if db_type == "sqlite" %}
    cursor.execute("PRAGMA table_info('{{ table.name }}')")
    columns = [
        {"name": row["name"], "type": row["type"], "nullable": not row["notnull"], "pk": bool(row["pk"])}
        for row in cursor.fetchall()
    ]
{% elif db_type == "postgresql" %}
    cursor.execute("""
        SELECT column_name, data_type, is_nullable,
               CASE WHEN pk.column_name IS NOT NULL THEN true ELSE false END AS is_pk
        FROM information_schema.columns c
        LEFT JOIN (
            SELECT ku.column_name
            FROM information_schema.table_constraints tc
            JOIN information_schema.key_column_usage ku ON tc.constraint_name = ku.constraint_name
            WHERE tc.constraint_type = 'PRIMARY KEY' AND tc.table_name = '{{ table.name }}'
        ) pk ON c.column_name = pk.column_name
        WHERE c.table_name = '{{ table.name }}'
        ORDER BY c.ordinal_position
    """)
    columns = [
        {"name": row[0], "type": row[1], "nullable": row[2] == "YES", "pk": row[3]}
        for row in cursor.fetchall()
    ]
{% elif db_type == "mysql" %}
    cursor.execute("DESCRIBE `{{ table.name }}`")
    columns = [
        {"name": row[0], "type": row[1], "nullable": row[2] == "YES", "pk": row[3] == "PRI"}
        for row in cursor.fetchall()
    ]
{% endif %}

    result = {"table": "{{ table.name }}", "columns": columns, "row_count": {{ table.row_count }}}
    conn.close()
    return [TextContent(type="text", text=json.dumps(result, indent=2, ensure_ascii=False, default=str))]


@server.tool()
async def sample_{{ table.name }}(limit: int = 5) -> list[TextContent]:
    """Get sample rows from the '{{ table.name }}' table."""
    conn = _get_conn()
    cursor = conn.cursor()

{% if db_type == "sqlite" %}
    cursor.execute(f"SELECT * FROM '{{ table.name }}' LIMIT ?", (min(limit, 100),))
{% elif db_type == "postgresql" %}
    cursor.execute(f'SELECT * FROM "{{ table.name }}" LIMIT %s', (min(limit, 100),))
{% elif db_type == "mysql" %}
    cursor.execute(f"SELECT * FROM `{{ table.name }}` LIMIT %s", (min(limit, 100),))
{% endif %}

{% if db_type == "sqlite" %}
    rows = [dict(row) for row in cursor.fetchall()]
{% else %}
    col_names = [desc[0] for desc in cursor.description]
    rows = [dict(zip(col_names, row)) for row in cursor.fetchall()]
{% endif %}

    conn.close()
    return [TextContent(type="text", text=json.dumps(rows, indent=2, ensure_ascii=False, default=str))]

{% endfor %}
@server.tool()
async def run_query(query: str) -> list[TextContent]:
    """Execute a read-only SQL query against the database."""
    q = query.strip().lower()
    if not q.startswith("select") and not q.startswith("explain") and not q.startswith("pragma") and not q.startswith("show") and not q.startswith("describe"):
        return [TextContent(type="text", text="Error: Only read-only queries allowed (SELECT, EXPLAIN, PRAGMA, SHOW, DESCRIBE).")]

    conn = _get_conn()
    cursor = conn.cursor()

    try:
        cursor.execute(query)
{% if db_type == "sqlite" %}
        rows = [dict(row) for row in cursor.fetchall()]
{% else %}
        if cursor.description:
            col_names = [desc[0] for desc in cursor.description]
            rows = [dict(zip(col_names, row)) for row in cursor.fetchall()]
        else:
            rows = []
{% endif %}
        conn.close()
        return [TextContent(type="text", text=json.dumps(rows, indent=2, ensure_ascii=False, default=str))]
    except Exception as e:
        conn.close()
        return [TextContent(type="text", text=f"Query error: {e}")]


async def main():
    async with stdio_server() as (read_stream, write_stream):
        await server.run(read_stream, write_stream, server.create_initialization_options())


if __name__ == "__main__":
    import asyncio
    asyncio.run(main())
